# CreatorAI Environment Configuration Example

# Frontend / Vite Supabase Configuration
# (Optional: If left blank or not configured, the app automatically runs in rich offline Demo Mode with 100% full functionality!)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Secure Server AI Configuration
# (Never exposed to the browser client. If omitted, the secure server runs the deterministic high-precision fallback engine.)
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=your-alternative-ai-api-key-here

# Backend Server Port (for standalone Express server)
PORT=3001
VITE_API_URL=http://localhost:3001
